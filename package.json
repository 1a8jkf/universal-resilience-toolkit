  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test:types": "tsc -p tests/types/tsconfig.json",
    "test": "npm run build && npm run test:node && npm run test:adapters",
    "test:node": "node scripts/run-portable.mjs node",
    "test:bun": "node scripts/run-portable.mjs bun",
    "test:deno": "node scripts/run-portable.mjs deno",
    "test:workers": "node scripts/run-portable.mjs workers",
    "test:edge": "node scripts/run-portable.mjs edge",
    "test:adapters": "node --test tests/adapters.test.mjs",
    "test:redis": "node --test tests/redis.integration.test.mjs",
    "test:package": "node scripts/check-package.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run build && npm run typecheck && npm run lint && npm run format:check && npm run test:node && npm run test:adapters && npm run test:types && npm run test:package",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run check && changeset publish",
    "prepack": "npm run build"
  },
